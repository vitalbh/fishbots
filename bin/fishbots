#!/bin/sh
# fishbots: talks to the running Fishbots (127.0.0.1, port FISHBOTS_PORT or 7777). bin/aquario is the old name.
#
#   fishbots state <source> <entity> <state> [label]   states: born busy idle waiting ok alert error done end
#   fishbots tool  <source> <entity> <name>            activity pulse (a short note)
#   fishbots event <source> <name> [label]             food in the tank (e.g. deploy, commit)
#   fishbots gauge <source> <name> <value 0..1|end>    e.g. disk 0.87 ("end" removes it)
#   fishbots effect <source> <name> [label]            e.g. fireworks, lightning, quake, school (docs/scene.md)
#   fishbots presence <source> <id> <kind> <state> [label] [detail]   a creature or object (docs/scene.md)
#   fishbots presence <source> <id> end                takes it out
#   fishbots summon <creature|all>                     a passing creature comes by now (whale, turtle, sunfish…)
#   fishbots show                                      current state as JSON
#
#   fishbots spawn [--agent id] [--cwd dir] [--label text] [--beside] [--env NAME]… [prompt]   start a session in
#                                            a new tab of the terminal this runs in (Rex, Herdr, tmux; --beside: a
#                                            pane next to this one; --launcher picks another), as a child of this
#                                            session; prints its fish once it's born. It gets this shell's
#                                            CLAUDE_CONFIG_DIR and CODEX_HOME (the same account), and any --env
#                                            NAME or NAME=value
#   fishbots reply <fish> <text>             type a line into a session (fish: "source:entity", or the start of the entity)
#   fishbots stop <fish>                     Esc: interrupt what it's doing
#   fishbots wait [--states a,b] [--timeout secs] <fish>…   until one is done, waiting or error: which, and its reply
#                                            (these four need "Sessions can command other sessions" in Preferences)
#
#   fishbots pack new <id> [folder]          start a pack from the template (themes, fish, scenery, creatures)
#   fishbots pack check <folder>             validate it and compile its drawings (errors at the pack's file:line)
#   fishbots pack preview <folder> [out.png] draw all its drawings on a sheet (and at their real size)
#   fishbots pack cover <folder>             cover.png, the picture of the pack in the catalog
#   fishbots pack dev <folder>               link it into the app: it reloads by itself on every save
#   fishbots pack zip <folder> [out]         make a .fishbotspack to share
#   fishbots pack install <file|url>         install a .fishbotspack (or double-click it in the Finder)
#   fishbots pack list | reload              what's installed (and its problems) | read the packs again
#
#   fishbots agent new <id> [name]           a manifest for another agent (name, fish, timbre, event/tool maps)
#   fishbots agent list | reload             every agent (built in, /agent/<id>) and manifest problems | read them again
#   fishbots agent test <id>                 a fake session at /agent/<id>: prompt, tools, a reply, the end
#   fishbots agent send <id> <json>          one event, as the agent's hook would send it (docs/agents.md)
#
#   fishbots plugin log <name> [lines]      the end of a plugin's log: its runs, stderr and refused lines
#   fishbots plugin logs                     the logs folder (~/Library/Logs/Fishbots/plugins)
#
#   fishbots skill install                   teach your coding agent to make packs, connect agents and run other
#                                            sessions (~/.claude/skills)
URL="http://127.0.0.1:${FISHBOTS_PORT:-${AQUARIO_PORT:-7777}}"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
PACKS="$HOME/Library/Application Support/Fishbots/packs"
AGENTS="$HOME/Library/Application Support/Fishbots/agents"

# the app's binary (it also previews and checks packs, without opening the aquarium)
app_bin() {
  if [ -n "${FISHBOTS_APP:-}" ]; then [ -x "$FISHBOTS_APP" ] && { echo "$FISHBOTS_APP"; return; }; echo "fishbots: FISHBOTS_APP isn't executable" >&2; exit 1; fi
  # the newest of the builds found (an older one wouldn't know the newer options and would open the aquarium instead)
  best=""
  for b in "$HERE/.build/release/Fishbots" "$HERE/build/Fishbots.app/Contents/MacOS/Fishbots" "/Applications/Fishbots.app/Contents/MacOS/Fishbots"; do
    [ -x "$b" ] || continue
    if [ -z "$best" ] || [ "$b" -nt "$best" ]; then best="$b"; fi
  done
  [ -n "$best" ] && { echo "$best"; return; }
  echo "fishbots: the app wasn't found (build it with scripts/app.sh, or set FISHBOTS_APP)" >&2; exit 1
}
running() { curl -s -m 1 "$URL/" >/dev/null 2>&1; }

pack() {
  sub="$1"; [ $# -gt 0 ] && shift
  case "$sub" in
    new)
      [ $# -ge 1 ] || { echo "usage: fishbots pack new <id> [folder]" >&2; exit 2; }
      id="$1"; echo "$id" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,40}$' || { echo "fishbots: the id is lowercase letters, digits, - and _" >&2; exit 2; }
      dir="${2:-./$id}"; [ -e "$dir" ] && { echo "fishbots: $dir already exists" >&2; exit 1; }
      fn=$(printf '%s' "$id" | tr -- '-' '_')
      mkdir -p "$dir" && cp "$HERE/packs/template/"* "$dir/"
      for f in "$dir"/*; do sed -i '' -e "s/draw_template_/draw_${fn}_/g" -e "s/template-/$id-/g" -e "s/\"template\"/\"$id\"/g" "$f"; done
      echo "✓ $dir: a pack with a theme, a fish, a piece of scenery and a creature"
      echo "  next: fishbots pack preview $dir   (draws everything; look at the images after each change)"
      echo "        fishbots pack dev $dir       (with the app open: it reloads the pack on every save)" ;;
    check)
      [ $# -ge 1 ] || { echo "usage: fishbots pack check <folder> [--catalog] [--offline]" >&2; exit 2; }
      "$(app_bin)" --check "$@" ;;
    preview)
      [ $# -ge 1 ] || { echo "usage: fishbots pack preview <folder> [out.png]" >&2; exit 2; }
      "$(app_bin)" --preview "$1" --out "${2:-$1/preview.png}" ;;
    cover)
      [ $# -ge 1 ] || { echo "usage: fishbots pack cover <folder>" >&2; exit 2; }
      "$(app_bin)" --cover "$1" --out "$1/cover.png" ;;
    dev)
      [ $# -ge 1 ] || { echo "usage: fishbots pack dev <folder>" >&2; exit 2; }
      dir="$(cd "$1" && pwd)"; id=$(sed -n 's/^[[:space:]]*"id":[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/pack.json" | head -1)
      [ -n "$id" ] || { echo "fishbots: no \"id\" in $dir/pack.json" >&2; exit 1; }
      mkdir -p "$PACKS"
      if [ -e "$PACKS/$id" ] && [ ! -L "$PACKS/$id" ]; then echo "fishbots: $PACKS/$id is an installed copy; remove it first" >&2; exit 1; fi
      ln -sfn "$dir" "$PACKS/$id"
      echo "✓ $id is linked: the aquarium reloads it whenever you save (pick its theme in the menu)"
      running && curl -s -m 10 -X POST "$URL/packs/reload" >/dev/null && echo "  reloaded" || echo "  (open the app to see it)" ;;
    zip)
      [ $# -ge 1 ] || { echo "usage: fishbots pack zip <folder> [out.fishbotspack]" >&2; exit 2; }
      "$(app_bin)" --check "$1" || { echo "fishbots: fix the problems first" >&2; exit 1; }
      dir="$(cd "$1" && pwd)"; out="${2:-$(dirname "$dir")/$(basename "$dir").fishbotspack}"
      rm -f "$out"; (cd "$dir" && zip -q -r - . -x 'preview*.png' -x '.*') > "$out" && echo "✓ $out" ;;
    install)
      [ $# -ge 1 ] || { echo "usage: fishbots pack install <file.fishbotspack|url>" >&2; exit 2; }
      src="$1"
      case "$src" in
        http://*) echo "fishbots: only https:// links (a pack over http could be swapped on the way)" >&2; exit 1 ;;
        https://*) tmp="$(mktemp -d)/pack.fishbotspack"; curl -fsSL -m 60 "$src" -o "$tmp" || { echo "fishbots: download failed" >&2; exit 1; }; src="$tmp" ;;
      esac
      [ -f "$src" ] || { echo "fishbots: $src not found" >&2; exit 1; }
      src="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
      if running; then
        curl -s -m 30 -H 'Content-Type: application/json' --data-binary "{\"path\":\"$(esc "$src")\"}" "$URL/packs/install"; echo
      else
        echo "fishbots: open the app first (it checks the pack while installing it), or double-click the file" >&2; exit 1
      fi ;;
    list)   curl -s -m 2 "$URL/packs" || { echo "fishbots: is the app running?" >&2; exit 1; }; echo ;;
    reload) curl -s -m 30 -X POST "$URL/packs/reload" || { echo "fishbots: is the app running?" >&2; exit 1; }; echo ;;
    *) sed -n '/^#   fishbots pack new/,/^#   fishbots skill/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
}

# agents without Swift: events at POST /agent/<id>, an optional manifest in agents/<id>.json (docs/agents.md)
agent() {
  sub="$1"; [ $# -gt 0 ] && shift
  case "$sub" in
    new)
      id="$1"
      printf '%s' "$id" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$' || { echo "usage: fishbots agent new <id> [name]   (id: lowercase letters, digits, -)" >&2; exit 2; }
      f="$AGENTS/$id.json"
      [ -e "$f" ] && { echo "fishbots: $f already exists" >&2; exit 1; }
      mkdir -p "$AGENTS"
      cat > "$f" <<JSON
{
  "id": "$id",
  "name": "${2:-$id}",
  "processNames": ["$id"],
  "timbre": "pluck",
  "events": {},
  "tools": {}
}
JSON
      echo "✓ $f"
      echo "  fish: add \"fish\": \"<kind>\" (oval, slender, puffer, angelfish, stingray, octopus… or a pack's); default: by the terminal"
      echo "  events/tools: map the agent's names to Claude Code's, e.g. \"events\": {\"turn_end\": \"Stop\"}, \"tools\": {\"run\": \"Bash\"}"
      echo "  its hook: plugins/common/hook.sh agent/$id   (forwards stdin and where the session runs)"
      echo "  then: fishbots agent reload   and   fishbots agent test $id"
      running && curl -s -m 5 -X POST "$URL/agents/reload" >/dev/null && echo "  (reloaded)" ;;
    list)   curl -s -m 2 "$URL/agents" || { echo "fishbots: is the app running?" >&2; exit 1; }; echo ;;
    reload) curl -s -m 5 -X POST "$URL/agents/reload" || { echo "fishbots: is the app running?" >&2; exit 1; }; echo ;;
    send)
      [ $# -ge 2 ] || { echo "usage: fishbots agent send <id> '<json>'" >&2; exit 2; }
      curl -s -m 2 -H 'Expect:' -H 'Content-Type: application/json' -H "X-Where-Term: ${TERM_PROGRAM:-}" \
        --data-binary "$2" "$URL/agent/$1" || { echo "fishbots: is the app running?" >&2; exit 1; }; echo ;;
    test)
      [ $# -ge 1 ] || { echo "usage: fishbots agent test <id>" >&2; exit 2; }
      running || { echo "fishbots: is the app running?" >&2; exit 1; }
      s="test-$(date +%s)"; c="$(pwd)"
      # ev <event> [extra JSON fields]: the JSON is built in a variable (inside "$(…)" its braces got expanded)
      ev() {
        body=$(printf '{"hook_event_name":"%s","session_id":"%s","cwd":"%s"%s}' "$1" "$s" "$(esc "$c")" "${2:+,$2}")
        code=$(curl -s -m 2 -o /dev/null -w "%{http_code}" -H 'Content-Type: application/json' --data-binary "$body" "$URL/agent/$id")
        printf '  %-28s %s\n' "$1${3:+ $3}" "$code"
      }
      id="$1"
      ev SessionStart; sleep 1
      ev UserPromptSubmit '"session_title":"Fishbots test"'; sleep 1
      for t in Read Edit Bash; do ev PreToolUse "\"tool_name\":\"$t\",\"tool_input\":{}" "$t"; sleep 1.2; done
      ev Stop '"last_assistant_message":"Done: this was a Fishbots test. All good?"' "(a reply)"
      echo "  the fish $id:$s is waiting now (its reply ends with a question): look at it and its card"
      echo "  it leaves in 10 s (Ctrl-C keeps it there)"
      sleep 10; ev SessionEnd ;;
    *) sed -n '/^#   fishbots agent new/,/^#   fishbots agent send/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
}

# script plugins (~/Library/Application Support/Fishbots/plugins): their logs
plugin() {
  logs="$HOME/Library/Logs/Fishbots/plugins"
  case "$1" in
    log)
      [ -n "$2" ] || { echo "usage: fishbots plugin log <name> [lines]   (e.g. github.5m.sh)" >&2; exit 2; }
      f="$logs/$2.log"
      [ -f "$f" ] || { echo "fishbots: no log for $2 yet ($f)"; ls "$logs" 2>/dev/null | sed 's/\.log$//' | sed 's/^/  /'; exit 1; }
      tail -n "${3:-40}" "$f" ;;
    logs) echo "$logs"; ls -1 "$logs" 2>/dev/null ;;
    *) sed -n '/^#   fishbots plugin log/,/^#   fishbots plugin logs/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
}

skill() {
  case "$1" in
    install)
      root="${2:-$HOME/.claude/skills}"
      for s in fishbots-packs fishbots-agents fishbots-orchestrator; do
        mkdir -p "$root/$s" && cp -R "$HERE/skills/$s/"* "$root/$s/" && echo "✓ $root/$s"
      done
      echo "  your agent now knows how to make Fishbots packs, connect other agents and run other sessions" ;;
    *) echo "usage: fishbots skill install [skills folder]   (default: ~/.claude/skills)" >&2; exit 2 ;;
  esac
}

esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
# the same, keeping line breaks and tabs (a prompt of several lines)
esclines() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{ gsub(/\t/, "\\t"); gsub(/\r/, ""); printf "%s%s", (NR > 1 ? "\\n" : ""), $0 }'; }
post() { curl -s -m 2 -H 'Expect:' -H 'Content-Type: application/json' --data-binary "$1" "$URL/event" || { echo "fishbots: is the app running?" >&2; exit 1; }; echo; }

# control <verb> <max seconds> <json>: exits 1 when the app refuses (the reason is in the JSON it prints)
# It says where it runs, as the hooks do: that's how the app knows which session is asking.
control() {
  out=$(curl -s -m "$2" -H 'Expect:' -H 'Content-Type: application/json' \
    -H "X-Where-Rex-Block: ${REX_BLOCK:-}" -H "X-Where-Herdr: ${HC_TERMINAL_ID:-}" -H "X-Where-Tmux: ${TMUX_PANE:-}" \
    --data-binary "$3" "$URL/control/$1") || { echo "fishbots: is the app running?" >&2; exit 1; }
  printf '%s\n' "$out"
  case "$out" in *'"error"'*) exit 1 ;; esac
}

cmd="$1"; [ $# -gt 0 ] && shift
# the original Portuguese commands still work
case "$cmd" in
  estado) cmd=state ;; ferramenta) cmd=tool ;; evento) cmd=event ;; medidor) cmd=gauge ;; ver) cmd=show ;;
esac
case "$cmd" in
  state) [ $# -ge 3 ] || { echo "usage: fishbots state <source> <entity> <state> [label]" >&2; exit 2; }
         post "{\"source\":\"$(esc "$1")\",\"entity\":\"$(esc "$2")\",\"state\":\"$(esc "$3")\",\"label\":\"$(esc "${4:-}")\"}" ;;
  tool)  [ $# -ge 3 ] || { echo "usage: fishbots tool <source> <entity> <name>" >&2; exit 2; }
         post "{\"source\":\"$(esc "$1")\",\"entity\":\"$(esc "$2")\",\"tool\":\"$(esc "$3")\"}" ;;
  event) [ $# -ge 2 ] || { echo "usage: fishbots event <source> <name> [label]" >&2; exit 2; }
         post "{\"source\":\"$(esc "$1")\",\"event\":\"$(esc "$2")\",\"label\":\"$(esc "${3:-}")\"}" ;;
  gauge) [ $# -ge 3 ] || { echo "usage: fishbots gauge <source> <name> <value>" >&2; exit 2; }
         v="$3"; [ "$v" = "end" ] && v=null
         post "{\"source\":\"$(esc "$1")\",\"gauge\":\"$(esc "$2")\",\"value\":$v}" ;;
  effect) [ $# -ge 2 ] || { echo "usage: fishbots effect <source> <name> [label]" >&2; exit 2; }
         post "{\"source\":\"$(esc "$1")\",\"effect\":\"$(esc "$2")\",\"label\":\"$(esc "${3:-}")\"}" ;;
  summon) [ $# -ge 1 ] || { echo "usage: fishbots summon <creature|all>" >&2; exit 2; }
         post "{\"source\":\"cli\",\"summon\":\"$(esc "$1")\"}" ;;
  presence)
         if [ "$3" = "end" ]; then post "{\"source\":\"$(esc "$1")\",\"presence\":\"$(esc "$2")\",\"state\":\"end\"}"
         else
           [ $# -ge 4 ] || { echo "usage: fishbots presence <source> <id> <kind> <state> [label] [detail]  |  <source> <id> end" >&2; exit 2; }
           d=""; [ -n "${6:-}" ] && d=",\"detail\":\"$(esc "$6")\""
           l=""; [ -n "${5:-}" ] && l=",\"label\":\"$(esc "$5")\""
           post "{\"source\":\"$(esc "$1")\",\"presence\":\"$(esc "$2")\",\"kind\":\"$(esc "$3")\",\"state\":\"$(esc "$4")\"$l$d}"
         fi ;;
  show)  curl -s -m 2 "$URL/state" || { echo "fishbots: is the app running?" >&2; exit 1; } ;;
  spawn) agent=""; dir="$PWD"; label=""; launcher=""; timeout=30; beside=""; vars="CLAUDE_CONFIG_DIR CODEX_HOME"; set_vars=""
         while [ $# -gt 0 ]; do
           case "$1" in
             --agent) agent="$2"; shift 2 ;;
             --cwd) dir="$2"; shift 2 ;;
             --label) label="$2"; shift 2 ;;
             --launcher) launcher="$2"; shift 2 ;;
             --timeout) timeout="$2"; shift 2 ;;
             --beside) beside=1; shift ;;
             --env) case "$2" in
                      *=*) set_vars="$set_vars,\"$(esc "${2%%=*}")\":\"$(esc "${2#*=}")\"" ;;
                      *) vars="$vars $2" ;;
                    esac; shift 2 ;;
             --) shift; break ;;
             --*) echo "usage: fishbots spawn [--agent id] [--cwd dir] [--label text] [--beside] [--env NAME[=value]]… [--launcher id] [--timeout secs] [prompt]" >&2; exit 2 ;;
             *) break ;;
           esac
         done
         case "$timeout" in ''|*[!0-9]*) echo "fishbots: --timeout takes seconds" >&2; exit 2 ;; esac
         dir=$(cd "$dir" 2>/dev/null && pwd) || { echo "fishbots: --cwd isn't a folder" >&2; exit 2; }
         j="{\"cwd\":\"$(esc "$dir")\",\"timeout\":$timeout"
         [ -n "$agent" ] && j="$j,\"agent\":\"$(esc "$agent")\""
         [ -n "$label" ] && j="$j,\"label\":\"$(esc "$label")\""
         [ -n "$launcher" ] && j="$j,\"launcher\":\"$(esc "$launcher")\""
         [ -n "$beside" ] && j="$j,\"beside\":true"
         [ $# -gt 0 ] && j="$j,\"prompt\":\"$(esclines "$*")\""
         e="$set_vars"
         for v in $vars; do
           case "$v" in ''|*[!A-Za-z0-9_]*) continue ;; esac
           val=$(printenv "$v") && [ -n "$val" ] && e="$e,\"$v\":\"$(esc "$val")\""
         done
         [ -n "$e" ] && j="$j,\"env\":{${e#,}}"
         control spawn $((timeout + 15)) "$j}" ;;
  reply) [ $# -ge 2 ] || { echo "usage: fishbots reply <fish> <text>" >&2; exit 2; }
         f="$1"; shift
         control reply 20 "{\"fish\":\"$(esc "$f")\",\"text\":\"$(esc "$(printf '%s' "$*" | tr '\n\r\t' '   ')")\"}" ;;
  stop)  [ $# -ge 1 ] || { echo "usage: fishbots stop <fish>" >&2; exit 2; }
         control stop 5 "{\"fish\":\"$(esc "$1")\"}" ;;
  wait)  states=""; timeout=600
         while [ $# -gt 0 ]; do
           case "$1" in
             --states) states="$2"; shift 2 ;;
             --timeout) timeout="$2"; shift 2 ;;
             *) break ;;
           esac
         done
         [ $# -ge 1 ] || { echo "usage: fishbots wait [--states done,waiting,error] [--timeout secs] <fish>…" >&2; exit 2; }
         case "$timeout" in ''|*[!0-9]*) echo "fishbots: --timeout takes seconds" >&2; exit 2 ;; esac
         list=""; for f in "$@"; do list="$list${list:+,}\"$(esc "$f")\""; done
         s=""; [ -n "$states" ] && s=",\"states\":[\"$(esc "$states" | sed 's/,/","/g')\"]"
         control wait $((timeout + 10)) "{\"fish\":[$list]$s,\"timeout\":$timeout}" ;;
  pack)  pack "$@" ;;
  agent) agent "$@" ;;
  plugin) plugin "$@" ;;
  skill) skill "$@" ;;
  *)     sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

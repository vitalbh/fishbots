{
  "fishbots": {
    "SessionStart": [
      {
        "type": "command",
        "command": "~/Dev/fishbots/plugins/antigravity/hook.sh SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/Dev/fishbots/plugins/antigravity/hook.sh PreInvocation",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/Dev/fishbots/plugins/antigravity/hook.sh PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/Dev/fishbots/plugins/antigravity/hook.sh Stop",
        "timeout": 5
      }
    ]
  }
}
